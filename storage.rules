rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Citizen uploaded report photos
    match /citizen_reports/{fileName} {
      allow read: if true;
      // Allow citizen uploads if image and size under 5MB
      allow create: if request.resource.contentType.matches('image/.*')
                    && request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Authority uploaded repair proof photos
    match /proof_photos/{fileName} {
      allow read: if true;
      // Allow upload only if authenticated and file is image under 10MB
      allow create, update: if request.auth != null
                            && request.resource.contentType.matches('image/.*')
                            && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
